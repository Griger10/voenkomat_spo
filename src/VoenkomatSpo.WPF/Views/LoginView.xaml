<UserControl x:Class="VoenkomatSpo.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoenkomatSpo.WPF.Controls"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             FontFamily="{StaticResource InterFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,56">
            <StackPanel Width="448" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Fill="{StaticResource AccentBrush}" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="МИНИСТЕРСТВО ОБРАЗОВАНИЯ • СПО РФ" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.08" />
                    </Border.Effect>
                    <Grid>
                        <Border Background="{StaticResource PrimaryBrush}" Height="4" VerticalAlignment="Top" CornerRadius="8,8,0,0" />
                        <StackPanel Margin="32">
                            <Grid Height="154">
                                <Border Background="#F2F4F1" Width="56" Height="56" CornerRadius="4" Padding="6" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Image Source="/Assets/emblem.png" Stretch="UniformToFill" AutomationProperties.Name="Эмблема воинского учёта СПО" />
                                </Border>
                                <TextBlock Text="Воинский учёт студентов СПО" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource HeadingBrush}" TextAlignment="Center" VerticalAlignment="Top"
                                           Margin="0,80,0,0" LineHeight="26" LineStackingStrategy="BlockLineHeight" />
                                <TextBlock Text="Вход в автоматизированную систему учёта" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center" VerticalAlignment="Top"
                                           Margin="0,110,0,0" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                            </Grid>
                            <StackPanel>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Логин" Style="{StaticResource FieldLabel}" />
                                    <Border Style="{StaticResource FieldFrame}">
                                        <Grid>
                                            <svg:SvgViewbox Source="/Assets/Icons/user.svg" Width="15" Height="15" HorizontalAlignment="Left" Margin="12.5,0,0,0" IsHitTestVisible="False" />
                                            <Grid Margin="39,0,11,0">
                                                <TextBlock Text="Введите ваш логин" FontSize="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Login}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox x:Name="LoginBox" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                                         Style="{StaticResource LoginTextBox}" AutomationProperties.Name="Логин" TabIndex="0" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                                    <controls:PasswordInput Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsPasswordVisible="{Binding IsPasswordVisible}" />
                                    <StackPanel Orientation="Horizontal" Margin="2,8,0,0" Height="16">
                                        <svg:SvgViewbox Source="/Assets/Icons/shield.svg" Width="9.33333" Height="11.6667" Margin="0,0,6,0" />
                                        <TextBlock Text="Защищённое соединение ГОСТ Р 34.12-2015" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"
                                                   ToolTip="Текст из макета. Соответствие подключения ГОСТ требует отдельной настройки инфраструктуры."
                                                   LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                                    </StackPanel>
                                    <CheckBox Content="Запомнить меня на этом устройстве" IsChecked="{Binding RememberMe}" Style="{StaticResource RememberCheckBox}"
                                              Margin="0,20,0,0" Height="20" TabIndex="3" />
                                </StackPanel>
                                <Border Background="#FFF0EE" CornerRadius="4" Padding="10" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#9E3026" FontSize="12" />
                                </Border>
                                <Button Command="{Binding SignInCommand}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" IsDefault="True" TabIndex="4"
                                        AutomationProperties.Name="Войти в систему">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SubmitText}" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        <svg:SvgViewbox Source="/Assets/Icons/sign-in.svg" Width="13.5" Height="13.5" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="14" Margin="0,24,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <svg:SvgViewbox Source="/Assets/Icons/info.svg" Width="16.6667" Height="16.6667" VerticalAlignment="Top" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="Для получения доступа обратитесь к&#10;администратору." Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="13" LineHeight="21.125" LineStackingStrategy="BlockLineHeight" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="0,40,0,0">
                                <TextBlock TextAlignment="Center" LineHeight="16" LineStackingStrategy="BlockLineHeight">
                                    <Run Text="Поддержка: " FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /><Run Text="otdel-kadrov@spo-college.edu.ru" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                </TextBlock>
                                <TextBlock Text="Версия 2.4.1 • Сборка АИС ВУ-2026" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           TextAlignment="Center" Margin="0,4,0,0" LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <svg:SvgViewbox Source="/Assets/Icons/law.svg" Width="12" Height="12.6667" Margin="0,0,8,0" />
                    <TextBlock Text="Ведение воинского учёта регламентировано ФЗ № 53" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
