<Window x:Class="VoenkomatSpo.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:VoenkomatSpo.WPF.Views"
        mc:Ignorable="d"
        Title="Воинский учёт студентов СПО" Height="881" Width="1296" MinWidth="580" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}"
        FontFamily="{StaticResource InterFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <views:LoginView DataContext="{Binding Login}" Visibility="{Binding DataContext.Login.IsAnonymous, Converter={StaticResource BoolVisibility}, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Visible}" />
        <views:DocumentsView DataContext="{Binding Documents}" Visibility="{Binding DataContext.Login.IsAuthenticated, Converter={StaticResource BoolVisibility}, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Collapsed}" />
    </Grid>
</Window>
