<Window x:Class="VoenkomatSpo.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:VoenkomatSpo.WPF.Views"
        mc:Ignorable="d"
        Title="Воинский учёт студентов СПО" Height="881" Width="1296" MinWidth="580" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}"
        FontFamily="{StaticResource InterFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <views:LoginView Visibility="{Binding IsAnonymous, Converter={StaticResource BoolVisibility}}" />
        <Border Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisibility}}" Width="448"
                Padding="32" Background="White" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Image Source="/Assets/emblem.png" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,24" />
                <TextBlock Text="Вход выполнен" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}" />
                <TextBlock Text="{Binding CurrentUser.Login}" FontSize="16" Margin="0,16,0,6" />
                <TextBlock Text="{Binding CurrentUser.Role}" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding SessionNotice}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,16,0,0" />
                <Button Content="Выйти из системы" Command="{Binding SignOutCommand}" Style="{StaticResource PrimaryButton}" Margin="0,24,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
