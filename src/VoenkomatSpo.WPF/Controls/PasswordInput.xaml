<UserControl x:Class="VoenkomatSpo.WPF.Controls.PasswordInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             x:Name="Root" Focusable="False">
    <Border Style="{StaticResource FieldFrame}">
        <Grid>
            <svg:SvgViewbox Source="/Assets/Icons/lock.svg" Width="12" Height="15.75" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
            <Grid Margin="39,0,39,0">
                <TextBlock Text="Введите пароль доступа" FontSize="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Password, ElementName=Root}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <PasswordBox x:Name="MaskedPassword" PasswordChanged="OnPasswordChanged" MaxLength="1024"
                             Background="Transparent" BorderThickness="0" Padding="0" FontSize="14"
                             VerticalContentAlignment="Center" AutomationProperties.Name="Пароль" TabIndex="1">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPasswordVisible, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                    <PasswordBox.Template>
                        <ControlTemplate TargetType="PasswordBox">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </ControlTemplate>
                    </PasswordBox.Template>
                </PasswordBox>
                <TextBox x:Name="VisiblePassword" MaxLength="1024" Text="{Binding Password, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Пароль открытым текстом" TabIndex="1" SpellCheck.IsEnabled="False">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource LoginTextBox}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPasswordVisible, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,9,0"
                    Command="{Binding TogglePasswordVisibilityCommand}" TabIndex="2">
                <Button.ToolTip>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Показать пароль" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible, ElementName=Root}" Value="True">
                                        <Setter Property="Text" Value="Скрыть пароль" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button.ToolTip>
                <AutomationProperties.Name>Показать или скрыть пароль</AutomationProperties.Name>
                <svg:SvgViewbox Source="/Assets/Icons/eye.svg" Width="16.5" Height="11.25" />
            </Button>
        </Grid>
    </Border>
</UserControl>
